# Biến môi trường cho MySQL service
MYSQL_ROOT_PASSWORD=hellobao0X@ # Thay bằng mật khẩu mạnh
MYSQL_DATABASE=quan_li_sinh_vien         # Tên database của bạn

# Biến môi trường cho Web service (ứng dụng FastAPI)
# Sử dụng tên service 'db' làm hostname để kết nối đến MySQL container
# Mật khẩu nên được URL-encoded nếu có ký tự đặc biệt như '@'
DATABASE_URL="mysql+aiomysql://root:hellobao0X%40@db:3306/${MYSQL_DATABASE}"
